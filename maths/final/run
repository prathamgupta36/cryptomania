#!/usr/bin/exec-suid -- /usr/bin/python3

import time
import random
import math
from pathlib import Path
from rich.console import Console
from rich.panel import Panel
from rich.table import Table
from rich.progress import Progress, SpinnerColumn, TextColumn
from rich.text import Text
from rich.align import Align
from rich.prompt import Prompt
import pyfiglet
import colorama

# Initialize colorama for cross-platform support
colorama.init()

class EnhancedRSATutorial:
    def __init__(self):
        self.console = Console()
        self.colors = {
            'primary': 'bright_blue',
            'secondary': 'bright_magenta',
            'accent': 'bright_cyan',
            'info': 'bright_yellow',
            'warning': 'bright_red',
            'error': 'bright_red',
            'success': 'bright_green'
        }

    def display_banner(self):
        banner = pyfiglet.figlet_format("Cryptomania", font="slant")
        subtitle = Text("Ultimate Test\n RSA Mastery", 
                        style=f"bold {self.colors['info']}")
        panel = Panel(
            Align.center(Text(banner, style=f"bold {self.colors['primary']}") +
                         Text("\n") + subtitle),
            border_style=self.colors['accent'],
            padding=(1, 2)
        )
        self.console.print(panel)
        with Progress(
            SpinnerColumn(), TextColumn("[progress.description]{task.description}"),
            console=self.console, transient=True
        ) as prog:
            task = prog.add_task("Initializing RSA modules...", total=100)
            for _ in range(100):
                prog.update(task, advance=1)
                time.sleep(0.005)

    def shuffle_reveal(self, flag: str):
        panel = Panel(Text("Decoding flag...", style=f"bold {self.colors['info']}"),
                      border_style=self.colors['secondary'])
        self.console.print(panel)
        time.sleep(0.75)
        revealed = ['_'] * len(flag)
        for i, ch in enumerate(flag):
            if ch in '{}_':
                revealed[i] = ch
            else:
                for _ in range(10):
                    revealed[i] = random.choice('ABCDEFGHIJKLMNOPQRSTUVWXYZ'
                                                'abcdefghijklmnopqrstuvwxyz'
                                                '0123456789')
                    self.console.print("".join(revealed), end="\r")
                    time.sleep(0.1)
                revealed[i] = ch
            self.console.print("".join(revealed), end="\r")
            time.sleep(0.1)
        self.console.print("\n")

    def simulate_rsa_scenario(self):
        panel = Panel(Text("Simplified RSA Scenario", 
                           style=f"bold {self.colors['info']}"),
                      border_style=self.colors['accent'])
        self.console.print(panel)
        time.sleep(0.5)

        # Educational RSA parameters
        p, q = 7, 11
        n = p * q
        phi_n = (p - 1) * (q - 1)
        e = 13

        data = [
            ("p", str(p)),
            ("q", str(q)),
            ("n = p×q", str(n)),
            ("φ(n)", str(phi_n)),
            ("e", str(e))
        ]
        table = Table(show_header=False)
        for k, v in data:
            table.add_row(k, v)
        self.console.print(table)
        time.sleep(1)
        return p, q, n, phi_n, e

    def interactive_challenges(self, p, q, n, phi_n, e):
        # Challenge 1: Compute private key
        self.console.rule(Text("Challenge 1: Private Exponent", 
                               style=f"bold {self.colors['secondary']}"))
        correct_d = pow(e, -1, phi_n)
        ans1 = Prompt.ask(f"Find d: {e}×d ≡ 1 (mod {phi_n})")
        if ans1.isdigit() and int(ans1) == correct_d:
            self.console.print(f"[green]Success! d = {correct_d}[/green]")
        else:
            self.console.print(f"[red]Incorrect. d = {correct_d}[/red]")
            return False
        time.sleep(1)

        # Challenge 2: RSA-CRT decryption
        self.console.rule(Text("Challenge 2: CRT Decryption", 
                               style=f"bold {self.colors['secondary']}"))
        c = random.randint(10, 30)
        self.console.print(f"Ciphertext c = {c}")
        # Compute dp, dq
        dp = correct_d % (p - 1)
        dq = correct_d % (q - 1)
        m1 = pow(c, dp, p)
        m2 = pow(c, dq, q)
        ans2a = Prompt.ask(f"Compute m₁ = {c}^{dp} mod {p}")
        if ans2a.isdigit() and int(ans2a) == m1:
            self.console.print("[green]m₁ correct[/green]")
        else:
            self.console.print(f"[red]m₁ = {m1}[/red]")
            return False
        ans2b = Prompt.ask(f"Compute m₂ = {c}^{dq} mod {q}")
        if ans2b.isdigit() and int(ans2b) == m2:
            self.console.print("[green]m₂ correct[/green]")
        else:
            self.console.print(f"[red]m₂ = {m2}[/red]")
            return False
        # CRT combine
        M1, M2 = q, p
        y1, y2 = pow(M1, -1, p), pow(M2, -1, q)
        plaintext = (m1 * M1 * y1 + m2 * M2 * y2) % n
        ans2c = Prompt.ask("Final decrypted message")
        if ans2c.isdigit() and int(ans2c) == plaintext:
            self.console.print("[green]Decryption successful![/green]")
        else:
            self.console.print(f"[red]Plaintext = {plaintext}[/red]")
            return False
        time.sleep(1)

        # Challenge 3: Advanced modular computation
        self.console.rule(Text("Challenge 3: Advanced Crypto Math", 
                               style=f"bold {self.colors['secondary']}"))
        m, a, b = 5, 127, 231
        # custom lcm
        lambda_n = abs((p - 1) * (q - 1)) // math.gcd(p - 1, q - 1)
        ar, br = a % lambda_n, b % lambda_n
        t1, t2 = pow(m, ar, n), pow(m, br, n)
        correct3 = (t1 + t2) % n
        ans3 = Prompt.ask(f"Compute ({m}^{a} + {m}^{b}) mod {n}")
        if ans3.isdigit() and int(ans3) == correct3:
            self.console.print("[green]Correct![/green]")
        else:
            self.console.print(f"[red]Result = {correct3}[/red]")
            return False
        time.sleep(1)
        # Final Master Puzzle
        self.console.rule(Text("Final Master Puzzle", 
                               style=f"bold {self.colors['secondary']}"))
        sa, sb, mod = 17, 19, 23
        c1 = (5*sa + 3*sb) % mod
        c2 = pow(sa, 3, mod)
        c3 = (sa + sb) % mod
        self.console.print(f"1. (5a+3b) ≡ {c1} (mod {mod})")
        self.console.print(f"2. a³ ≡ {c2} (mod {mod})")
        self.console.print(f"3. a+b ≡ {c3} (mod {mod})")
        corr = sa * sb
        ans4 = Prompt.ask("Compute a × b")
        if ans4.isdigit() and int(ans4) == corr:
            self.console.print("[green]Puzzle solved![/green]")
        else:
            self.console.print(f"[red]Answer = {corr}[/red]")
            return False

        return True

    def load_flag(self):
        try:
            return Path("/flag").read_text().strip()
        except:
            return "FLAG{demo_flag_not_found}"

    def run(self):
        self.console.clear()
        self.display_banner()
        p, q, n, phi, e = self.simulate_rsa_scenario()
        if not self.interactive_challenges(p, q, n, phi, e):
            self.console.print(Text("Try again later!", 
                                    style=f"bold {self.colors['warning']}"))
            return
        self.console.print(Text("You are now a Modular Arithmetic Master!", 
                                style=f"bold {self.colors['success']}"))
        time.sleep(0.5)
        flag = self.load_flag()
        print(flag)

if __name__ == "__main__":
    EnhancedRSATutorial().run()

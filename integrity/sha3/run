#!/usr/bin/exec-suid -- /usr/bin/python3

import base64
import hashlib
from pathlib import Path

MESSAGE = base64.b64encode(hashlib.sha256(Path("/flag").read_bytes().strip()).digest()).decode()
CORRECT_HASH = hashlib.sha3_256(MESSAGE.encode()).hexdigest()

def load_flag():
    return Path("/flag").read_text().strip()

def main():
    print("Challenge: SHA3-256")
    print("Compute the SHA3-256 digest of the message below.")
    print(f"Message: {MESSAGE}")

    submitted_hash = input("Digest: ").strip()
    if submitted_hash == CORRECT_HASH:
        print("Correct.")
        print(f"Flag: {load_flag()}")
    else:
        print("Incorrect digest.")
        print(f"Expected prefix: {CORRECT_HASH[:10]}...")

if __name__ == "__main__":
    main()

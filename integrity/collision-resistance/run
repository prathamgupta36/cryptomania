#!/usr/bin/exec-suid -- /usr/bin/python3

import hashlib
from pathlib import Path

def load_flag():
    return Path("/flag").read_text().strip()

def main():
    print("Challenge: Collision Resistance")
    print("Submit two different hex-encoded messages, each at least 32 bytes long, that collide under a 5-byte SHAKE256 digest.")

    message_a_hex = input("First message (hex): ").strip()
    message_b_hex = input("Second message (hex): ").strip()

    try:
        message_a = bytes.fromhex(message_a_hex)
        message_b = bytes.fromhex(message_b_hex)

        if message_a == message_b:
            print("The two messages must be different.")
            return

        if len(message_a) < 32 or len(message_b) < 32:
            print("Each message must be at least 32 bytes long.")
            return

        shake_a = hashlib.shake_256()
        shake_a.update(message_a)
        hash_a = shake_a.hexdigest(5)

        shake_b = hashlib.shake_256()
        shake_b.update(message_b)
        hash_b = shake_b.hexdigest(5)

        if hash_a == hash_b:
            print("Correct.")
            print(f"Flag: {load_flag()}")
        else:
            print("The hashes do not match.")
            print(f"Hash of message A: {hash_a}")
            print(f"Hash of message B: {hash_b}")

    except ValueError:
        print("Invalid hex input.")

if __name__ == "__main__":
    main()

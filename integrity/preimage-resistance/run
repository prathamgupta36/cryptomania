#!/usr/bin/exec-suid -- /usr/bin/python3

import hashlib
from pathlib import Path

MESSAGE = hashlib.sha256(Path("/flag").read_bytes().strip()).digest()
shake = hashlib.shake_256()
shake.update(MESSAGE)
TARGET_HASH = shake.hexdigest(3)

def load_flag():
    return Path("/flag").read_text().strip()

def main():
    print("Challenge: Preimage Resistance")
    print("Find any hex-encoded message whose 3-byte SHAKE256 digest matches the target below.")
    print(f"Target hash: {TARGET_HASH}")

    submitted_preimage_hex = input("Preimage (hex): ").strip()

    try:
        submitted_preimage = bytes.fromhex(submitted_preimage_hex)
        shake = hashlib.shake_256()
        shake.update(submitted_preimage)
        submitted_hash = shake.hexdigest(3)

        if submitted_hash == TARGET_HASH:
            print("Correct.")
            print(f"Flag: {load_flag()}")
        else:
            print("Incorrect preimage.")
            print(f"Computed hash: {submitted_hash}")
            print(f"Expected hash: {TARGET_HASH}")
    except ValueError:
        print("Invalid hex input.")

if __name__ == "__main__":
    main()

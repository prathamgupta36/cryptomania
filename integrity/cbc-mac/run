#!/usr/bin/exec-suid -- /usr/bin/python3

import os
import hashlib
from pathlib import Path
from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes

def load_flag():
    return Path("/flag").read_text().strip()

def main():
    key = os.urandom(16)
    message = hashlib.sha256(Path("/flag").read_bytes().strip()).digest()[:32]
    iv = bytes(16)

    cipher = Cipher(algorithms.AES(key), modes.CBC(iv))
    encryptor = cipher.encryptor()
    ciphertext = encryptor.update(message) + encryptor.finalize()
    correct_tag = ciphertext[-16:]

    print("Challenge: CBC-MAC")
    print("Compute the AES-CBC-MAC tag for the message below.")
    print(f"Key: {key.hex()}")
    print(f"Message (hex): {message.hex()}")

    submitted_tag_hex = input("Tag (hex): ").strip()

    try:
        submitted_tag = bytes.fromhex(submitted_tag_hex)
        if submitted_tag == correct_tag:
            print("Correct.")
            print(f"Flag: {load_flag()}")
        else:
            print("Incorrect tag.")
            print(f"Submitted tag: {submitted_tag.hex()}")
            print(f"Correct tag:   {correct_tag.hex()}")
    except ValueError:
        print("Invalid hex input.")

if __name__ == "__main__":
    main()

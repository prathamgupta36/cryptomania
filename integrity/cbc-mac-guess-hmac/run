#!/usr/bin/exec-suid -- /usr/bin/python3

import random
import hashlib
import hmac
from pathlib import Path

def load_flag():
    return Path("/flag").read_text().strip()

def main():
    info = ["Alice", "Brown", "1987", "0524", "Boston", "MA", "8479024972", "2805", "Artist", "SAIC", "Football", "hiking", "traveling", "reading", "photographing" , "baking"]
    special_char = ["!", "@", "#", "$", "%", "^", "&", "*"]

    password = ""
    for _ in range(4):
        password += random.choice(info)
        password += random.choice(special_char)

    message = b"wire 100,000 dollars to Bob. -Alice"
    correct_tag = hmac.new(password.encode(), message, hashlib.sha256).hexdigest()

    print("Challenge: Weak HMAC Keys")
    print("Recover the password used as the HMAC key.")
    print(f"Message: {message.decode()}")
    print(f"Tag: {correct_tag}")
    print("Password format: 4 entries from the info list, each followed by 1 special character.")
    print(f"Info list: {', '.join(info)}")
    print(f"Special characters: {' '.join(special_char)}")

    submitted_password = input("Password: ").strip()

    computed_tag = hmac.new(submitted_password.encode(), message, hashlib.sha256).hexdigest()
    if computed_tag == correct_tag:
        print("Correct.")
        print(f"Flag: {load_flag()}")
    else:
        print("Incorrect password.")
        print(f"Your computed tag: {computed_tag}")
        print(f"Correct tag:      {correct_tag}")

if __name__ == "__main__":
    main()

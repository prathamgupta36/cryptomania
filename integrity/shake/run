#!/usr/bin/exec-suid -- /usr/bin/python3

import hashlib
from pathlib import Path

MESSAGE = hashlib.sha256(Path("/flag").read_bytes().strip()).digest().hex()
snake = hashlib.shake_256()
snake.update(MESSAGE.encode())
CORRECT_HASH = snake.hexdigest(16)

def load_flag():
    return Path("/flag").read_text().strip()

def main():
    print("Challenge: SHAKE256")
    print("Compute the 16-byte SHAKE256 output for the message below.")
    print(f"Message: {MESSAGE}")

    submitted_hash = input("Digest: ").strip()
    if submitted_hash == CORRECT_HASH:
        print("Correct.")
        print(f"Flag: {load_flag()}")
    else:
        print("Incorrect digest.")
        print(f"Expected prefix: {CORRECT_HASH[:3]}...")

if __name__ == "__main__":
    main()

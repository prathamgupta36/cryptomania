#!/usr/bin/exec-suid -- /usr/bin/python3

import os
import hashlib
from pathlib import Path
from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes

def load_flag():
    return Path("/flag").read_text().strip()

def main():
    key = os.urandom(16)
    original_message = os.urandom(32)
    original_iv = os.urandom(16)
    target_first_block = hashlib.sha256(Path("/flag").read_bytes().strip()).hexdigest().encode()[:16]

    cipher = Cipher(algorithms.AES(key), modes.CBC(original_iv))
    encryptor = cipher.encryptor()
    ciphertext = encryptor.update(original_message) + encryptor.finalize()
    original_tag = ciphertext[-16:]

    print("Challenge: CBC-MAC with Random IV")
    print("Compute a new IV so that the modified message keeps the original tag.")
    print(f"Key: {key.hex()}")
    print(f"Original message (hex): {original_message.hex()}")
    print(f"Original IV (hex): {original_iv.hex()}")
    print(f"Original tag (hex): {original_tag.hex()}")
    print(f"Target first block (hex): {target_first_block.hex()}")

    submitted_iv_hex = input("New IV (hex): ").strip()

    try:
        submitted_iv = bytes.fromhex(submitted_iv_hex)
        new_message = target_first_block + original_message[16:]
        cipher = Cipher(algorithms.AES(key), modes.CBC(submitted_iv))
        encryptor = cipher.encryptor()
        ciphertext = encryptor.update(new_message) + encryptor.finalize()
        new_tag = ciphertext[-16:]

        if new_tag == original_tag:
            print("Correct.")
            print(f"Flag: {load_flag()}")
        else:
            print("Incorrect IV.")
            print(f"New tag:      {new_tag.hex()}")
            print(f"Original tag: {original_tag.hex()}")

    except ValueError:
        print("Invalid hex input.")

if __name__ == "__main__":
    main()
